<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Tamarind Tree Hotel</title>

<style>
body { margin:0; font-family:Segoe UI; }

/* HEADER */
header {
background: linear-gradient(45deg,#2c3e50,#27ae60);
color:white; text-align:center; padding:15px;
}

nav a { color:white; margin:10px; text-decoration:none; }

/* HERO */
.hero {
background: linear-gradient(rgba(0,0,0,0.5),rgba(0,0,0,0.5)),
url('https://images.unsplash.com/photo-1566073771259-6a8506099945');
background-size:cover;
color:white; text-align:center; padding:120px;
}

/* SECTION */
section { padding:40px; text-align:center; }

/* ROOMS */
.room-container { display:flex; flex-wrap:wrap; justify-content:center; }
.room {
background:white; margin:15px; padding:15px;
width:230px; border-radius:10px;
box-shadow:0 3px 10px rgba(0,0,0,0.2);
}
.room img { width:100%; border-radius:10px; }

/* GALLERY */
.gallery img {
width:250px; margin:10px;
border-radius:10px;
}

/* FORM */
form {
background:white;
display:inline-block;
padding:20px;
border-radius:10px;
box-shadow:0 3px 10px rgba(0,0,0,0.2);
}

form input, form select {
display:block; margin:10px auto;
padding:10px; width:220px;
}

button {
padding:10px;
background:#27ae60;
color:white; border:none;
cursor:pointer;
}

button:hover { background:#219150; }

/* FOOTER */
footer {
background:#2c3e50;
color:white;
text-align:center;
padding:10px;
}
</style>

</head>
<body>

<header>
<h1>🌴 Tamarind Tree Hotel</h1>
<nav>
<a href="#">Home</a>
<a href="#rooms">Rooms</a>
<a href="#gallery">Gallery</a>
<a href="#booking">Booking</a>
</nav>
</header>

<section class="hero">
<h2>Luxury Stay Experience</h2>
<p>Relax • Refresh • Enjoy</p>
</section>

<!-- ROOMS -->
<section id="rooms">
<h2>Our Rooms</h2>

<div class="room-container">

<div class="room">
<img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85">
<h3>Deluxe Room</h3>
<p>₹1000/night</p>
</div>

<div class="room">
<img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2">
<h3>Suite Room</h3>
<p>₹2000/night</p>
</div>

<div class="room">
<img src="https://images.unsplash.com/photo-1551882547-ff40c63fe5fa">
<h3>Family Room</h3>
<p>₹3000/night</p>
</div>

</div>
</section>

<!-- GALLERY -->
<section id="gallery">
<h2>Hotel Gallery</h2>

<div class="gallery">
<img src="https://images.unsplash.com/photo-1551776235-dde6d4829808">
<img src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb">
<img src="https://images.unsplash.com/photo-1501117716987-c8e1ecb210f0">
</div>

</section>

<!-- BOOKING -->
<section id="booking">
<h2>Book Your Stay</h2>

<form onsubmit="bookRoom(event)">
<input type="text" id="name" placeholder="Enter Name" required>

<input type="date" id="checkin" required>
<input type="date" id="checkout" required>

<select id="room">
<option value="1000">Deluxe Room</option>
<option value="2000">Suite Room</option>
<option value="3000">Family Room</option>
</select>

<input type="number" id="guests" placeholder="Guests" required>

<button type="submit">Book Now</button>

<p id="result"></p>
</form>

</section>

<footer>
<p>© 2026 Tamarind Tree Hotel</p>
</footer>

<script>
function bookRoom(e){
e.preventDefault();

let name = document.getElementById("name").value;
let checkin = new Date(document.getElementById("checkin").value);
let checkout = new Date(document.getElementById("checkout").value);
let price = document.getElementById("room").value;

let days = (checkout - checkin)/(1000*60*60*24);

if(days <= 0){
alert("Invalid dates!");
return;
}

let total = days * price;

document.getElementById("result").innerHTML =
"✅ Booking Confirmed <br>" +
"Name: "+name+"<br>" +
"Days: "+days+"<br>" +
"Total: ₹"+total;
}
</script>

</body>
</html>
